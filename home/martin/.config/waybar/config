{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "cpu",
    "custom/gpu",
    "memory",
    "pulseaudio",
    "network#wifi",
    "custom/bluetooth",
    "custom/battery",
    "clock",
    "tray",
    "custom/power"
  ],
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{name}"
  },
  "sway/mode": {
    "format": "{}"
  },
  "sway/window": {
    "max-length": 50,
    "rewrite": {
      "(.*) — (.*)": "$1",
      "(.*) - (.*)": "$1"
    }
  },
  "cpu": {
    "interval": 5,
    "format": " {usage}%",
    "tooltip-format": "CPU: {usage}%\n{icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}{icon8}{icon9}{icon10}{icon11}{icon12}{icon13}{icon14}{icon15}",
    "format-icons": [
      "<span color='#55aa55'>▁</span>",
      "<span color='#66bb55'>▂</span>",
      "<span color='#77cc55'>▃</span>",
      "<span color='#f5a70a'>▄</span>",
      "<span color='#f5a70a'>▅</span>",
      "<span color='#ff9933'>▆</span>",
      "<span color='#ff5555'>▇</span>",
      "<span color='#ff0000'>█</span>"
    ]
  },
  "memory": {
    "interval": 5,
    "format": " {percentage}%",
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
  },
  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu.sh",
    "return-type": "json",
    "interval": 5
  },
  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": " mute",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },
  "network#wifi": {
    "interface": "wlp*",
    "format-wifi": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} — {signalStrength}%\n{ipaddr}",
    "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
  },
  "custom/bluetooth": {
    "exec": "~/.config/waybar/scripts/bluetooth.sh",
    "return-type": "json",
    "interval": 10,
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh"
  },
  "custom/battery": {
    "exec": "~/.config/waybar/scripts/battery.sh",
    "return-type": "json",
    "interval": 10,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/battery-menu.sh"
  },
  "clock": {
    "format": "{:%H:%M:%S}",
    "format-alt": "{:%a %d %b}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "interval": 1
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6
  }
}
