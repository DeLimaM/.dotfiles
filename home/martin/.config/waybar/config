{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["cpu", "custom/gpu", "memory", "pulseaudio", "network#wifi", "custom/bluetooth", "custom/battery", "clock", "tray"],

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "{}"
    },

    "sway/window": {
        "max-length": 50,
        "rewrite": {
            "(.*) — (.*)": "$1",
            "(.*) - (.*)": "$1"
        }
    },

    "cpu": {
        "interval": 2,
        "format": "\uf2db {usage}%",
        "tooltip-format": "CPU: {usage}%\n{icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}{icon8}{icon9}{icon10}{icon11}{icon12}{icon13}{icon14}{icon15}",
        "format-icons": ["<span color='#55aa55'>▁</span>",
                         "<span color='#66bb55'>▂</span>",
                         "<span color='#77cc55'>▃</span>",
                         "<span color='#f5a70a'>▄</span>",
                         "<span color='#f5a70a'>▅</span>",
                         "<span color='#ff9933'>▆</span>",
                         "<span color='#ff5555'>▇</span>",
                         "<span color='#ff0000'>█</span>"]
    },

    "memory": {
        "interval": 3,
        "format": "\uf1c0 {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "return-type": "json",
        "interval": 2
    },

    "pulseaudio": {
        "format": "\uf028 {volume}%",
        "format-muted": "\uf026 mute",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "network#wifi": {
        "interface": "wlp*",
        "format-wifi": "\uf1eb {signalStrength}%",
        "format-disconnected": "\uf1eb off",
        "tooltip-format-wifi": "{essid}\n{signalStrength}% — {ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "custom/bluetooth": {
        "exec": "~/.config/waybar/scripts/bluetooth.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "on-click": "blueman-manager"
    },

    "custom/battery": {
        "exec": "~/.config/waybar/scripts/battery.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/battery.sh click"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "interval": 60
    },

    "tray": {
        "icon-size": 13,
        "spacing": 4
    }
}
