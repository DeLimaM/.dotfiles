[global]
    monitor = 0
    follow = keyboard
    width = 320
    height = 120
    origin = top-right
    offset = 10x10
    notification_limit = 3
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    frame_color = "#38d8a3"
    gap_size = 4
    separator_height = 1
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = Iosevka 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 24
    max_icon_size = 32
    icon_path = /usr/share/icons/Adwaita/symbolic/status/:/usr/share/icons/Adwaita/symbolic/devices/
    corner_radius = 8
    mouse_left_click = close_current
    mouse_right_click = close_all
    mouse_middle_click = do_action
    layer = overlay

[urgency_low]
    background = "#1a182bee"
    foreground = "#6272a4"
    frame_color = "#2b2940"
    timeout = 3

[urgency_normal]
    background = "#1a182bee"
    foreground = "#cdd6f4"
    frame_color = "#38d8a3"
    timeout = 5

[urgency_critical]
    background = "#1a182bee"
    foreground = "#ffffff"
    frame_color = "#A54242"
    timeout = 0
